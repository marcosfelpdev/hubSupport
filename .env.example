# ==========================================
# HubSupport - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e configure os valores adequados.
# NUNCA comite credenciais, senhas reais ou chaves de API.
# ==========================================

# Configuração de Ambiente
PORT=4000
NODE_ENV=development

# Banco de Dados (Prisma ORM)
DATABASE_URL="postgresql://usuario:senha@host:5432/hubsupport"
DIRECT_URL="postgresql://usuario:senha@host:5432/hubsupport"

# Autenticação JWT
JWT_SECRET="gere-uma-chave-secreta-forte-com-openssl-rand-hex-32"

# Google Gemini AI
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"
GEMINI_MODEL="gemini-2.0-flash"

# Cloudflare R2 Storage (Obrigatório em produção, opcional em desenvolvimento)
R2_ACCOUNT_ID="seu_account_id_cloudflare"
R2_ACCESS_KEY_ID="sua_access_key_r2"
R2_SECRET_ACCESS_KEY="sua_secret_key_r2"
R2_BUCKET_NAME="hubsupport-storage"

# Configuração Inicial de Seed (Opcional - Customização de credenciais de teste)
ADMIN_SEED_NAME="Administrador"
ADMIN_SEED_EMAIL="admin@hubsupport.com"
ADMIN_SEED_PASSWORD="DefinaSuaSenhaSeguraAqui"
