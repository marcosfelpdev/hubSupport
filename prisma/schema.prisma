// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String                 @id @default(cuid())
  name             String
  email            String                 @unique
  password         String
  role             String                 @default("USER") // "ADMIN", "USER", "TECHNICIAN", "MANAGER"
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  notifications    Notification[]
  workLogs         WorkLog[]
  assignedEvents   AgendaEvent[]          @relation("AssignedAgendaEvents")
  createdEvents    AgendaEvent[]          @relation("CreatedAgendaEvents")
  statusChanges    WorkLogStatusHistory[]
  assignedWorkLogs WorkLog[]              @relation("AssignedWorkLogs")
  managedClients   Client[]               @relation("ClientManager")
  workLogNotes     WorkLogNote[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#3b82f6") // Cor hexadecimal da tag
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workLogs  WorkLog[]
}

model WorkLogCategory {
  id           String    @id @default(cuid())
  slug         String    @unique // ex: "technical_action", "implementation", "prompt", "idea", ou gerado pelo nome
  name         String    // ex: "Ação Técnica", "Prompt", "Infraestrutura"
  subtitle     String?   // ex: "Demanda técnica / dev"
  icon         String    @default("cog") // Chave do ícone Lucide: "cog", "rocket", "sparkles", "lightbulb", etc.
  color        String    @default("#3b82f6") // Cor hexadecimal da categoria
  notifyRole   String?   // "TECHNICIAN" | "ADMIN" | "MANAGER" | "USER" | null (nenhum)
  targetKanban Boolean   @default(true) // Direciona para o Kanban Técnico?
  lockStatus   Boolean   @default(true) // Trava status inicial na criação?
  targetStatus String?   @default("Backlog") // Status forçado quando lockStatus for true
  active       Boolean   @default(true) // Visível no formulário?
  order        Int       @default(0) // Ordem de exibição na grade
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workLogs     WorkLog[]
}

model WorkLog {
  id              String                 @id @default(cuid())
  title           String                 @default("") // Título do atendimento/relatório
  requester       String                 // Solicitante
  clientOrOffice  String                 // Escritório/Cliente
  reportedProblem        String                 @db.Text // Descrição do atendimento (antigo problema relatado)
  descriptionInterleaved String?                @db.Text // JSON estruturado alternando blocos de texto e referências de mídia
  actionTaken            String                 @default("") @db.Text // Ação realizada (integrada na descrição)
  status          String                 @default("Realizado") // Realizado, Em andamento, Aguardando reunião, Não foi possível realizar, Solucionado
  categoryId      String?
  category        WorkLogCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  technicalAction Boolean                @default(false) // Ação técnica (envio para equipe de programadores) [legado mantido para compatibilidade]
  implementation  Boolean                @default(false) // Implementação (sugestão de melhoria) [legado mantido para compatibilidade]
  isPrompt        Boolean                @default(false) // Prompt (engenharia / ajuste de prompt de IA) [legado mantido para compatibilidade]
  isIdea          Boolean                @default(false) // Ideia (sugestão de melhoria ou inovação) [legado mantido para compatibilidade]
  media           String                 @default("[]") @db.Text // JSON array de caminhos de arquivos anexados
  createdAt       DateTime               @default(now())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId           String?
  tag             Tag?                   @relation(fields: [tagId], references: [id], onDelete: SetNull)
  notifications   Notification[]
  aiReport        AiReport?
  statusHistory   WorkLogStatusHistory[]
  assignedToId    String?
  assignedTo      User?                  @relation("AssignedWorkLogs", fields: [assignedToId], references: [id], onDelete: SetNull)
  clientId        String?
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  hasValidationRejection Boolean       @default(false)
  validationStartedAt    DateTime?
  notes           WorkLogNote[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workLogId String?
  workLog   WorkLog? @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AiReport {
  id             String    @id @default(cuid())
  workLogId      String    @unique
  workLog        WorkLog   @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  status         String    @default("pending") // "pending", "processing", "completed", "failed"
  videoPath      String?
  pdfPath        String?
  structuredData String?   @db.Text // JSON com o relatório estruturado retornado pelo Gemini
  errorMessage   String?   @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AgendaEvent {
  id               String    @id @default(cuid())
  date             String    // YYYY-MM-DD
  time             String    // HH:mm
  title            String
  category         String    // "Reunião" | "Atendimento" | "Técnico" | "Lembrete"
  completed        Boolean   @default(false)
  employeeId       String?
  employee         User?     @relation("AssignedAgendaEvents", fields: [employeeId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?     @relation("CreatedAgendaEvents", fields: [createdById], references: [id], onDelete: SetNull)
  notificationSent Boolean   @default(false)
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  notes            String?   @db.Text
  media            String    @default("[]") @db.Text
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model WorkLogStatusHistory {
  id          String   @id @default(cuid())
  workLogId   String
  workLog     WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Client {
  id        String        @id @default(cuid())
  name      String        @unique
  managerId String?
  manager   User?         @relation("ClientManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  workLogs  WorkLog[]
  events    AgendaEvent[]
}

model WorkLogNote {
  id        String   @id @default(cuid())
  workLogId String
  workLog   WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  type      String   @default("general") // "general" | "rejection"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
