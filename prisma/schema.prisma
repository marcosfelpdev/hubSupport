// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("USER") // "ADMIN" ou "USER"
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  notifications Notification[]
  workLogs      WorkLog[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#3b82f6") // Cor hexadecimal da tag
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workLogs  WorkLog[]
}

model WorkLog {
  id               String         @id @default(cuid())
  title            String         @default("") // Título do atendimento/relatório
  requester        String         // Solicitante
  clientOrOffice   String         // Escritório/Cliente
  reportedProblem  String         // Descrição do atendimento (antigo problema relatado)
  actionTaken      String         @default("") // Ação realizada (integrada na descrição)
  status           String         @default("Realizado") // Realizado, Em andamento, Aguardando reunião, Não foi possível realizar, Solucionado
  technicalAction  Boolean        @default(false) // Ação técnica (envio para equipe de programadores)
  implementation   Boolean        @default(false) // Implementação (sugestão de melhoria)
  media            String         @default("[]") // JSON array de caminhos de arquivos anexados
  createdAt        DateTime       @default(now())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId            String?
  tag              Tag?           @relation(fields: [tagId], references: [id], onDelete: SetNull)
  notifications    Notification[]
  aiReport         AiReport?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workLogId String?
  workLog   WorkLog? @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AiReport {
  id             String    @id @default(cuid())
  workLogId      String    @unique
  workLog        WorkLog   @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  status         String    @default("pending") // "pending", "processing", "completed", "failed"
  videoPath      String?
  pdfPath        String?
  structuredData String?   // JSON com o relatório estruturado retornado pelo Gemini
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
